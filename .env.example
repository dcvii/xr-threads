# Database Configuration
# PostgreSQL connection string format: postgresql+psycopg2://username:password@host:port/database
DATABASE_URL=postgresql+psycopg2://admin:password@localhost:5432/threads_db

# Security Settings
# Secret key for session encryption (generate with `openssl rand -hex 32`)
SECRET_KEY=your_secret_key_here
# Number of rounds for bcrypt password hashing
BCRYPT_ROUNDS=12

# Application Settings
# Set to True for development, False for production
DEBUG=False
# Enable auto-reload during development
RELOAD=False

# Server Configuration
# Host to bind the server to (0.0.0.0 accepts connections from any IP)
HOST=0.0.0.0
# Port to bind the server to (usually 8000 for development, PORT env var is used by many hosting providers)
PORT=8000
# Number of worker processes (use 2-4 × $NUM_CORES in production)
WORKERS=1
# Logging level: critical, error, warning, info, debug, trace
LOG_LEVEL=info

# Testing Configuration
# Set to True to use in-memory SQLite for testing instead of PostgreSQL
TEST_MODE=False

# Email Configuration (for future use)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=username
# SMTP_PASSWORD=password
# EMAIL_FROM=noreply@example.com

# Misc
# Set the application environment: development, testing, production
ENVIRONMENT=development
# Base URL for the application (used for generating absolute URLs)
BASE_URL=http://localhost:8000
